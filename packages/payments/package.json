{
  "name": "@agripay/payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./reconcile": {
      "types": "./src/reconcile.ts",
      "import": "./dist/reconcile.js"
    },
    "./provision": {
      "types": "./src/provision.ts",
      "import": "./dist/provision.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agripay/schemas": "workspace:*",
    "@agripay/storage": "workspace:*",
    "@hashgraph/sdk": "2.74.0",
    "zod": "3.25.76"
  }
}
