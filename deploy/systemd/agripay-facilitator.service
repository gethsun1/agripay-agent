[Unit]
Description=AgriPay internal x402 facilitator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agripay
Group=agripay
WorkingDirectory=/opt/agripay-agent/current
EnvironmentFile=/etc/agripay-agent/facilitator.env
ExecStart=/opt/agripay-node/bin/node apps/facilitator/dist/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agripay-agent /var/log/agripay-agent
RestrictSUIDSGID=true
MemoryMax=512M
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
