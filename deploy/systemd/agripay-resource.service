[Unit]
Description=AgriPay protected resource server
After=network-online.target agripay-facilitator.service
Wants=network-online.target
Requires=agripay-facilitator.service

[Service]
Type=simple
User=agripay
Group=agripay
WorkingDirectory=/opt/agripay-agent/current
EnvironmentFile=/etc/agripay-agent/resource.env
ExecStart=/opt/agripay-node/bin/node apps/resource-server/dist/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agripay-agent /var/log/agripay-agent
RestrictSUIDSGID=true
MemoryMax=512M
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
