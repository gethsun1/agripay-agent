{
  "name": "agripay-agent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "hedera:provision": "pnpm --filter @agripay/payments build && node packages/payments/dist/provision-cli.js",
    "test:hedera:testnet": "pnpm --filter @agripay/live-test build && node apps/live-test/dist/index.js",
    "db:migrate": "pnpm --filter @agripay/storage build && node packages/storage/dist/cli.js migrate",
    "db:backup": "pnpm --filter @agripay/storage build && node packages/storage/dist/cli.js backup",
    "db:check": "pnpm --filter @agripay/storage build && node packages/storage/dist/cli.js check",
    "db:verify-backup": "pnpm --filter @agripay/storage build && node packages/storage/dist/cli.js verify-backup",
    "db:restore": "pnpm --filter @agripay/storage build && node packages/storage/dist/cli.js restore",
    "auth:hash-password": "pnpm --filter @agripay/security build && node packages/security/dist/hash-cli.js",
    "payments:reconcile": "pnpm --filter @agripay/payments build && node packages/payments/dist/reconcile-cli.js",
    "sbom": "node scripts/generate-sbom.mjs",
    "groq:models": "pnpm --filter @agripay/planner build && node packages/planner/dist/cli.js models",
    "demo:hedera:multi-resource": "pnpm --filter @agripay/live-test build && node apps/live-test/dist/multi.js",
    "web:dev": "pnpm --filter @agripay/web dev",
    "web:build": "pnpm --filter @agripay/web build",
    "test:e2e": "pnpm --filter @agripay/web test:e2e",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "24.0.15",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "1.12.7",
      "bn.js": "5.2.3",
      "protobufjs": "7.6.5"
    }
  }
}
